# Copy to .env and fill in. Credentials can also come from the AWS
# shared config (~/.aws/credentials) or an IAM role — leave the key
# lines blank in that case.

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Address or domain you have verified in Amazon SES.
SES_FROM_EMAIL=drops@yourstudio.com
SES_REPLY_TO=hello@yourstudio.com

# Shown in the email header and footer.
COMPANY_NAME=Your Jewelry Studio

# Set to true to compose and "send" without calling AWS.
DRY_RUN=false

PORT=3789
